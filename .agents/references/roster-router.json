{
  "version": "1.1.0",
  "owner": "@tech-lead",
  "tiebreak": "@founder",
  "source_of_truth": "artifacts/docs/review/07-roundtable.md sections 6, 8, 9",
  "rules": {
    "default_seats": 2,
    "hard_cap": 5,
    "untagged_fallback": [
      "tech-lead",
      "architect"
    ],
    "revisit_sla": {
      "max_override_rate": 0.20,
      "min_sessions": 10
    }
  },
  "policy": {
    "reserved_seat_2": "On tagged topics, seat 2 is the highest-ranked consulted agent (positional contract) acting as an active dialectic counterweight. Untagged topics seat owner + strongest dissenter.",
    "override": "User override '<agent> instead/add' is honored and logged as [ROUTING-OVERRIDE: default -> chosen — reason]. Host-initiated deviation requires [ROUTER-DEVIATION: rule -> action — evidence].",
    "sunset": "Router defaults expire 30 days / 20 roundtables after adoption on process metrics (override rate, p50 routing time, dispute count). Veto triggers are permanent safety invariants.",
    "measurement": "Owner @tech-lead counts [ROUTING-OVERRIDE]/[ROUTER-DEVIATION] markers across the last 10 roundtable transcripts and reports override rate, median rounds-to-synthesis, and dispute count in session-write. No new tooling — grep over transcripts.",
    "precedence": "On any conflict between this file and SKILL.md prose, this file wins. SKILL.md phase rosters are cost-mode defaults; tag matches override them."
  },
