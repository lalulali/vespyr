{
  "version": "2.0.0",
  "description": "Multi-locale Core Deslop & Plain-Clarity lexicon and regex patterns for Quirly, Vespyr, and Vancy",
  "locales": {
    "en": {
      "banned_ai_words": [
        "delve",
        "delving",
        "tapestry",
        "testament",
        "pivotal",
        "beacon",
        "crucial",
        "fostering",
        "interplay",
        "intricacies",
        "landscape",
        "underscores",
        "underscoring",
        "unspoken",
        "palpable",
        "cacophony",
        "kaleidoscope",
        "symphony",
        "ethereal",
        "resonate",
        "resonates",
        "resonating"
      ],
      "fancy_word_replacements": {
        "utilize": "use",
        "utilized": "used",
        "utilizing": "using",
        "utilization": "use",
        "ameliorate": "improve or fix",
        "elucidate": "explain",
        "juxtaposition": "contrast",
        "dichotomy": "split or divide",
        "myriad": "many",
        "plethora": "many",
        "ubiquitous": "everywhere",
        "ephemeral": "brief",
        "cognizant": "aware",
        "facilitate": "help",
        "facilitated": "helped",
        "facilitating": "helping",
        "paramount": "vital or first",
        "quintessential": "classic",
        "multifaceted": "complex",
        "conundrum": "problem",
        "labyrinthine": "twisting",
        "inexorable": "unstoppable",
        "inexorably": "steadily",
        "endeavor": "try",
        "endeavored": "tried",
        "commence": "start",
        "commenced": "started",
        "ascertain": "find out",
        "subsequently": "later or then",
        "furthermore": "also",
        "moreover": "also",
        "heretofore": "until now",
        "aforementioned": "this or that",
        "coalesce": "gather or merge",
        "disseminate": "spread",
        "exacerbate": "worsen",
        "proliferate": "multiply",
        "ostensibly": "seemingly",
        "phantasmagoria": "blur or rush",
        "veritable": "true or real"
      },
      "circumlocution_replacements": {
        "came to the realization": "realized (or state the thought directly)",
        "come to the realization": "realize",
        "made a decision to": "decided to",
        "make a decision to": "decide to",
        "in the process of": "cut wrapper; use the direct verb",
        "experienced a feeling of": "cut wrapper; name the feeling or physical action",
        "exhibited a tendency to": "tended to (or state the habit directly)",
        "at this point in time": "now",
        "due to the fact that": "because",
        "in order to": "to",
        "for the purpose of": "to",
        "in light of the fact that": "because",
        "with regard to": "about",
        "in close proximity to": "near",
        "serves as an indication": "shows",
        "a sense of unease": "state the concrete physical tension directly"
      },
      "banned_cliches": [
        "breath she didn't know she was holding",
        "breath he didn't know he was holding",
        "shiver ran down his spine",
        "shiver ran down her spine",
        "knuckles whitened",
        "jaw tightened",
        "heart hammered against ribs",
        "ghost of a smile",
        "let out a breath",
        "let out a chuckle",
        "pregnant pause",
        "metallic tang of fear",
        "metallic tang of blood",
        "whispered secrets",
        "in today's fast-paced world",
        "it's not just about",
        "serves as a testament",
        "stands as a testament"
      ],
      "regex_patterns": {
        "negative_parallelism": "\\b(?:it(?:'s| is| was) not (?:just|merely|only)\\b[^\n.?!]+?,\\s*(?:it(?:'s| is| was)|but)\\b|not a [a-z]+[,.]?\\s*not a [a-z]+[,.]?\\s*just a [a-z]+)",
        "superficial_ing_tail": "[,;]\\s+(?:highlighting|underscoring|symbolizing|reflecting|ensuring|contributing to|showcasing)\\s+[a-z]+",
        "copula_avoidance": "\\b(?:serves as|stands as|boasts a|features a)\\b",
        "scene_moralizing": "\\b(?:in that moment,?\\s+[a-z]+ realized|whatever happened next,?\\s+nothing would ever be the same)\\b",
        "em_dash_overuse": "(?:—[^—\n]+){3,}",
        "circumlocution_bloat": "\\b(?:came to the realization that|in the process of [a-z]+ing|for the purpose of [a-z]+ing|in light of the fact that|due to the fact that|experienced a (?:sudden )?feeling of)\\b"
      }
    },
    "id": {
      "banned_ai_words": [
        "menelisik",
        "merajut",
        "ranah",
        "krusial",
        "kancah",
        "harmoni",
        "simfoni",
        "niscaya",
        "dinamika",
        "pijakan",
        "denyut"
      ],
      "fancy_word_replacements": {
        "mengimplementasikan": "menerapkan",
        "mengakomodasi": "menampung atau memenuhi",
        "mengeksplorasi": "menjelajahi atau menggali",
        "mengartikulasikan": "menyampaikan",
        "manifestasi": "wujud",
        "dikotomi": "pemisahan",
        "paradigma": "cara pandang",
        "signifikansi": "arti penting",
        "komprehensif": "menyeluruh",
        "eksistensi": "keberadaan",
        "konstelasi": "susunan",
        "determinasi": "tekad"
      },
      "circumlocution_replacements": {
        "sampai pada kesadaran bahwa": "menyadari bahwa (atau tulis langsung faktanya)",
        "mengambil keputusan untuk": "memutuskan untuk",
        "berada dalam proses": "hapus pembungkus kata; gunakan kata kerja langsung",
        "disebabkan oleh fakta bahwa": "karena",
        "dalam rangka untuk": "untuk",
        "mengalami perasaan": "sebutkan langsung tindakan atau emosinya"
      },
      "banned_cliches": [
        "napas yang tak ia sadari ia tahan",
        "detak jantung yang berdegup kencang",
        "senyum tipis yang tersungging",
        "di era yang serba cepat ini",
        "bukan hanya sekadar"
      ],
      "regex_patterns": {
        "negative_parallelism": "\\bbukan (?:hanya|sekadar)\\b[^\n.?!]+?,\\s*(?:melainkan|tetapi)\\b",
        "superficial_ing_tail": "[,;]\\s+(?:menandakan|mencerminkan|menegaskan|memperkuat)\\s+[a-z]+",
        "circumlocution_bloat": "\\b(?:sampai pada kesadaran bahwa|disebabkan oleh fakta bahwa|dalam rangka untuk)\\b"
      }
    }
  }
}
