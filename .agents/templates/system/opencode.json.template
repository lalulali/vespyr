{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "memory-controller": {
      "description": "Memory gatekeeper — loads filtered context for agents (progressive tiers), validates and persists memory writes, compacts files that exceed thresholds, and archives resolved entries with a searchable index",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/.local/share/opencode/worktree/**": "allow"
    },
    "skill": {
      "analyze-data": "allow",
      "brainstorming": "allow",
      "code-graph": "allow",
      "craft-lesson": "allow",
      "create-agent": "allow",
      "create-skill": "allow",
      "customize-agent": "allow",
      "customize-skill": "allow",
      "design": "allow",
      "develop": "allow",
      "discovery-report": "allow",
      "doc-graph": "allow",
      "elicitation": "allow",
      "empathy-map": "allow",
      "explore-game-idea": "allow",
      "explore-idea": "allow",
      "grill-me": "allow",
      "help-me": "allow",
      "humanize": "allow",
      "incident": "allow",
      "iterate": "allow",
      "journey-map": "allow",
      "jtbd": "allow",
      "kanban": "allow",
      "launch": "allow",
      "memory": "allow",
      "motion": "allow",
      "phase": "allow",
      "plan": "allow",
      "research-plan": "allow",
      "retro": "allow",
      "review": "allow",
      "root-cause": "allow",
      "round-table": "allow",
      "shape-up": "allow",
      "sprint-status": "allow",
      "status": "allow",
      "teach-me": "allow",
      "test": "allow",
      "unpack-problem": "allow",
      "validate-game-idea": "allow",
      "validate-idea": "allow",
      "validation-patterns": "allow"
    }
  },
  "plugin": ["opencode-websearch-cited@1.2.0"]
}
