{
  "dimension": "prd_completeness",
  "name": "PRD & Planning Completeness Rubric",
  "description": "Evaluates problem clarity, acceptance criteria testability, and task scoping.",
  "passThreshold": 4,
  "criteria": [
    {
      "id": "PRD-1",
      "name": "Structured Problem Statement",
      "weight": 2,
      "requiredPatterns": [
        "problem|context|objective|motivation|goal"
      ]
    },
    {
      "id": "PRD-2",
      "name": "Testable Acceptance Criteria",
      "weight": 2,
      "requiredPatterns": [
        "given|when|then|acceptance criteria|verification|checklist|\\- \\[ \\]"
      ]
    },
    {
      "id": "PRD-3",
      "name": "Explicit Out-of-Scope Boundaries",
      "weight": 1,
      "requiredPatterns": [
        "out of scope|non-goals|boundaries|exclusions|omissions"
      ]
    },
    {
      "id": "PRD-4",
      "name": "Granular Sizing (1-4 Hour Rule)",
      "weight": 1,
      "requiredPatterns": [
        "task|breakdown|estimation|hours|phase|step"
      ]
    },
    {
      "id": "PRD-5",
      "name": "Evidence-Anchored Statements (reverse mode)",
      "weight": 1,
      "tier": "fixture-tier",
      "forwardNote": "Fixture-tier: upgrades to behavioral gating when the prompt-execution adapter lands (02l).",
      "requiredPatterns": [
        "[A-Za-z0-9._/-]+#[A-Za-z][A-Za-z0-9._:-]*",
        "Evidence Ledger|\\[OPEN\\]|\\[DEFERRED TO SPEC\\]"
      ]
    },
    {
      "id": "PRD-6",
      "name": "10-Class Detail Coverage",
      "weight": 1,
      "tier": "fixture-tier",
      "forwardNote": "Fixture-tier: upgrades to behavioral gating when the prompt-execution adapter lands (02l).",
      "requiredPatterns": [
        "Screen states|Edge cases|Data fields|Permissions|Navigation|Copy|Telemetry|Performance|Accessibility|Platform"
      ]
    }
  ]
}
